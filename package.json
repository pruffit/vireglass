{
  "name": "vireglass",
  "version": "1.1.0",
  "description": "A physically-derived liquid glass material for interfaces. One material model, one shader source, two render targets: WebGL2 and Android AGSL.",
  "license": "Apache-2.0",
  "author": "Danil Kotlaev",
  "homepage": "https://github.com/pruffit/vireglass#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pruffit/vireglass.git"
  },
  "bugs": {
    "url": "https://github.com/pruffit/vireglass/issues"
  },
  "keywords": [
    "glassmorphism",
    "liquid-glass",
    "webgl2",
    "agsl",
    "shader",
    "refraction",
    "react-native",
    "expo",
    "material",
    "ui"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "import": "./dist/web/index.js",
      "require": "./dist/web/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.js",
      "require": "./dist/dom.cjs"
    },
    "./law": {
      "types": "./dist/law.d.ts",
      "import": "./dist/law.js",
      "require": "./dist/law.cjs"
    },
    "./native": {
      "types": "./src/native/index.ts",
      "default": "./src/native/index.ts"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "docs",
    "src",
    "!src/__tests__",
    "android",
    "!android/build",
    "!android/.gradle",
    "expo-module.config.json",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:glsl": "tsx scripts/check-glsl.mjs",
    "check:optics": "tsx scripts/check-optics.mjs",
    "check:law": "node scripts/check-law.mjs",
    "check:dom": "node scripts/check-dom.mjs",
    "measure:dom": "node scripts/measure-dom.mjs",
    "prepare": "tsup",
    "check:package": "node scripts/check-package.mjs"
  },
  "peerDependencies": {
    "@shopify/react-native-skia": ">=2.0.0",
    "expo": ">=54",
    "expo-blur": ">=14",
    "expo-sensors": ">=14",
    "react": ">=19",
    "react-native": ">=0.79",
    "react-native-reanimated": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@shopify/react-native-skia": {
      "optional": true
    },
    "expo": {
      "optional": true
    },
    "expo-blur": {
      "optional": true
    },
    "expo-sensors": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.62.1",
    "tsup": "^8.5.0",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "~57.0.18",
    "expo-blur": "~57.0.2",
    "expo-sensors": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-reanimated": "4.5.1"
  }
}
